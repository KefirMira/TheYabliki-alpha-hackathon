# Copy to .env; choose local values. Never commit .env or paste its contents in reports.
# DB password: hexadecimal characters only, e.g. generated UUID without hyphens.
SUBMISSION_DB_PASSWORD=REPLACE_WITH_LOCAL_HEXADECIMAL_PASSWORD
# At least 12 characters. Login is demo-analyst; no password bypass.
SUBMISSION_DEMO_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
SUBMISSION_FRONTEND_PORT=8080
SUBMISSION_BACKEND_PORT=8000
# Default compose ignores any LLM key: demo uses fake, not paid SDK.
# For organizer, use the separate override and explicit pair confirmation.
LLM_API_KEY=
DATASET_AI_REAL_CONFIRMED=
DATASET_AI_REAL_PAIR_SHA256=

# Optional ONLY with compose.submission.network.yml, after checking subnet conflicts.
# SUBMISSION_SUBNET=

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHON_DOTENV_DISABLED=1
WORKDIR /app
COPY requirements-runtime.txt ./
RUN --mount=type=cache,target=/root/.cache/pip pip install --default-timeout=120 -r requirements-runtime.txt && pip check
RUN useradd --create-home --uid 10001 backend
COPY main.py settings.py saved_pilot_demo.py ./
COPY api ./api
COPY db ./db
COPY repositories ./repositories
COPY schemas ./schemas
COPY services ./services
COPY company_import ./company_import
COPY fixtures/gateway_macro_v1.json fixtures/saved_llm_pilot_v1.json ./fixtures/
USER backend
EXPOSE 8000
CMD ["python","-B","-m","uvicorn","main:app","--host","0.0.0.0","--port","8000","--no-access-log"]

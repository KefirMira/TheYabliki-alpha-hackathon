# Copy to backend/.env locally; never commit that file.
DATABASE_URL=
# Format: postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@localhost:5432/DATABASE
# Required for analysis only; never fill these in the committed example.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Prepared UTF-8 JSON directory, relative to backend/ or absolute external path.
RAG_KNOWLEDGE_BASE_DIR=data/processed
# Optional OCR executable; blank uses PATH. OCR is not needed for prepared JSON.
TESSERACT_CMD=
TESSERACT_LANGUAGES=rus+eng

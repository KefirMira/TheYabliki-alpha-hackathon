# Адрес API бэкенда «Пульса бизнеса» (docs/FRONTEND_DOCKER.md).
# Если порт 8000 занят, бэкенд запускают с BACKEND_PORT=8001 — тогда и здесь 8001.
VITE_BASE_API=http://localhost:8000

# Все компании демо-стенда: source_id через запятую.
VITE_DEMO_COMPANY_IDS=DEMO-001,DEMO-002,DEMO-003

# Тестовые логины, пока нет авторизации: «логин=ID,ID;логин2=ID». Пароль не
# проверяется. Пусто — подходит любой логин и видны все компании.
VITE_DEMO_ACCOUNTS=expert=DEMO-001,DEMO-002,DEMO-003;bakery=DEMO-001;workshop=DEMO-002;empty=DEMO-003
